{
  "manifest_version": 3,
  "name": "Trancy 桌面字幕连接器",
  "description": "将 B 站和 YouTube 的视频信息、播放进度及字幕翻译连接到 Trancy 桌面应用。",
  "version": "0.1.3",
  "version_name": "桌面连接版 0.1.3",
  "default_locale": "en",
  "key": "",
  "action": {
    "default_title": "Trancy 桌面字幕连接器"
  },
  "background": {
    "service_worker": "assets/background.js"
  },
  "permissions": ["storage", "contextMenus", "unlimitedStorage", "alarms"],
  "commands": {
    "ai-transcribe": {"description": "__MSG_aiTranscribe__"},
    "caption-toggle": {"description": "__MSG_captionToggle__"},
    "fulltext-translate": {"description": "__MSG_toggleFulltextImmersive__"},
    "quick-translator": {"description": "__MSG_quickTranslator__"},
    "toggle": {"description": "__MSG_toggleVideoImmersive__"}
  },
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "assets/icons/ic16.png",
    "32": "assets/icons/ic32.png",
    "48": "assets/icons/ic48.png",
    "128": "assets/icons/ic128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://youtube.com/*", "https://www.youtube.com/*", "https://m.youtube.com/*", "https://www.youtube-nocookie.com/*", "https://bilibili.com/*", "https://*.bilibili.com/*"],
      "js": ["assets/desktop-bridge-page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://youtube.com/*", "https://www.youtube.com/*", "https://m.youtube.com/*", "https://www.youtube-nocookie.com/*", "https://bilibili.com/*", "https://*.bilibili.com/*"],
      "js": ["assets/desktop-bridge-content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
